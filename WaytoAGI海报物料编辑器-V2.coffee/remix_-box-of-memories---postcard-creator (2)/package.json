{
    "name": "box-of-memories---postcard-creator",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "tsc --noEmit",
        "electron:dev": "electron .",
        "dist:win": "npm run build && electron-builder --win portable"
    },
    "dependencies": {
        "@google/genai": "^1.30.0",
        "lucide-react": "^0.555.0",
        "motion": "^12.34.3",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-zoom-pan-pinch": "^3.7.0"
    },
    "devDependencies": {
        "@types/node": "^22.14.0",
        "@vitejs/plugin-react": "^5.0.0",
        "electron": "^40.6.1",
        "electron-builder": "^26.8.1",
        "electron-packager": "^17.1.2",
        "typescript": "~5.8.2",
        "vite": "^6.2.0"
    },
    "build": {
        "appId": "com.waytoagi.editor",
        "productName": "WaytoAGI Editor",
        "directories": {
            "output": "build"
        },
        "files": [
            "dist/**/*",
            "electron-main.cjs",
            "preload.cjs",
            "package.json"
        ],
        "win": {
            "target": "portable"
        }
    },
    "main": "electron-main.cjs"
}
